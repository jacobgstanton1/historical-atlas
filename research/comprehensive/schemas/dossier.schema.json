{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-atlas.local/schemas/comprehensive-dossier-v2.json",
  "title": "Comprehensive entity/period evidence; research is not production truth",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "mapIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "worker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assignmentType": {
          "const": "comprehensive-entity-period"
        }
      },
      "required": [
        "id",
        "assignmentType"
      ],
      "additionalProperties": false
    },
    "productionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chronology": {
      "type": "object",
      "properties": {
        "calendar": {
          "const": "proleptic-gregorian"
        },
        "yearConvention": {
          "const": "astronomical"
        }
      },
      "required": [
        "calendar",
        "yearConvention"
      ],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
        },
        "until": {
          "type": "string",
          "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
        }
      },
      "required": [
        "from",
        "until"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "investigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "identity",
              "political-institutional",
              "leadership",
              "capital",
              "currency",
              "historical-flag",
              "population-statistics",
              "area-statistics",
              "density",
              "economy",
              "events-context",
              "relationships",
              "overview",
              "important-figures"
            ]
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "unresolved",
              "not-applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "consultedSourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "category",
          "status",
          "rationale",
          "consultedSourceIds",
          "gaps"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "description",
              "claimIds"
            ],
            "additionalProperties": false
          }
        ]
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "preservedPackageHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "createdAt",
        "method",
        "preservedPackageHashes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "jobId",
    "entityId",
    "mapIds",
    "worker",
    "productionFingerprint",
    "chronology",
    "period",
    "claims",
    "sources",
    "investigation",
    "conflicts",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "identity",
            "political-institutional",
            "leadership",
            "capital",
            "currency",
            "historical-flag",
            "population-statistics",
            "area-statistics",
            "density",
            "economy",
            "events-context",
            "relationships",
            "overview",
            "important-figures"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "temporal": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "interval"
                },
                "from": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "certainty": {
                  "enum": [
                    "exact",
                    "approximate",
                    "disputed"
                  ]
                }
              },
              "required": [
                "kind",
                "from",
                "until",
                "certainty"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "observation"
                },
                "observationDate": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "certainty": {
                  "enum": [
                    "exact",
                    "approximate",
                    "disputed"
                  ]
                }
              },
              "required": [
                "kind",
                "observationDate",
                "certainty"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "event"
                },
                "date": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "certainty": {
                  "enum": [
                    "exact",
                    "approximate",
                    "disputed"
                  ]
                }
              },
              "required": [
                "kind",
                "date",
                "certainty"
              ],
              "additionalProperties": false
            }
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "relationship": {
              "enum": [
                "same",
                "different",
                "uncertain",
                "compatible"
              ]
            }
          },
          "required": [
            "id",
            "description",
            "relationship"
          ],
          "additionalProperties": false
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "enum": [
                  "year",
                  "month",
                  "day"
                ]
              },
              "temporal": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "interval"
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                      },
                      "until": {
                        "type": "string",
                        "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                      },
                      "certainty": {
                        "enum": [
                          "exact",
                          "approximate",
                          "disputed"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "from",
                      "until",
                      "certainty"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "observation"
                      },
                      "observationDate": {
                        "type": "string",
                        "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                      },
                      "certainty": {
                        "enum": [
                          "exact",
                          "approximate",
                          "disputed"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "observationDate",
                      "certainty"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "event"
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                      },
                      "certainty": {
                        "enum": [
                          "exact",
                          "approximate",
                          "disputed"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "date",
                      "certainty"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "interpretation": {
                "enum": [
                  "direct",
                  "contextual",
                  "derived"
                ]
              }
            },
            "required": [
              "sourceId",
              "locator",
              "note",
              "precision",
              "temporal",
              "interpretation"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "unresolved"
          ]
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relatedParty": {
          "type": "string",
          "minLength": 1,
          "description": "Literal named party/group in an exact reused accepted status record; never an inferred entity link."
        },
        "relatedEntityIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "figure": {
          "type": "object",
          "properties": {
            "personId": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "lifespan": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
                }
              },
              "required": [
                "from",
                "until"
              ],
              "additionalProperties": false
            },
            "relationship": {
              "type": "string",
              "minLength": 1
            },
            "activity": {
              "type": "string",
              "minLength": 1
            },
            "contribution": {
              "type": "string",
              "minLength": 1
            },
            "portraitMetadata": {
              "type": "object"
            }
          },
          "required": [
            "personId",
            "name",
            "categories",
            "lifespan",
            "relationship",
            "activity",
            "contribution"
          ],
          "additionalProperties": false
        },
        "flag": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^\\./assets/flags/[a-zA-Z0-9_-]+\\.svg$"
            },
            "type": {
              "enum": [
                "national flag",
                "state flag",
                "civil flag",
                "state ensign",
                "civil ensign",
                "colonial ensign",
                "royal standard",
                "imperial standard",
                "administrative flag",
                "office standard",
                "state symbol"
              ]
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "licenseUrl": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            },
            "assetSourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "asset",
            "type",
            "alt",
            "license",
            "attribution",
            "assetSourceIds",
            "sha256"
          ],
          "additionalProperties": false
        },
        "derivation": {
          "type": "object",
          "properties": {
            "populationClaimId": {
              "type": "string",
              "minLength": 1
            },
            "areaClaimId": {
              "type": "string",
              "minLength": 1
            },
            "formula": {
              "const": "population / area"
            }
          },
          "required": [
            "populationClaimId",
            "areaClaimId",
            "formula"
          ],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "new-research",
                "preserved-package",
                "bulk-candidate",
                "production-reuse"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sourceIdentifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reference"
          ],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "required": [
            "id",
            "atlasEntityId",
            "external",
            "class",
            "period",
            "fields",
            "territorial",
            "rationale",
            "evidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "atlasEntityId": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "external": {
              "type": "object"
            },
            "period": {
              "type": "object"
            },
            "territorial": {
              "type": "object"
            },
            "rationale": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "minItems": 1
            },
            "worker": {
              "type": "string"
            },
            "review": {
              "type": "object"
            },
            "continuityEstablished": {
              "type": "boolean"
            },
            "competingEntity": {
              "type": "boolean"
            },
            "mutualScopeEvidence": {
              "type": "string"
            },
            "directAssociationEvidence": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "category",
        "value",
        "entityId",
        "temporal",
        "scope",
        "sourceIds",
        "evidence",
        "status",
        "risks",
        "qualifications",
        "origin"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "assetUrl": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "institution",
        "url",
        "accessed",
        "usage",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
