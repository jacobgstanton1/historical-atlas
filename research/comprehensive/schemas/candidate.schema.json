{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted normalized bulk candidate",
  "type": "object",
  "properties": {
    "sourceIdentifier": {
      "type": "string",
      "minLength": 1
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "identity",
        "political-institutional",
        "leadership",
        "capital",
        "currency",
        "historical-flag",
        "population-statistics",
        "area-statistics",
        "density",
        "economy",
        "events-context",
        "relationships",
        "overview",
        "important-figures"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "temporal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "interval"
            },
            "from": {
              "type": "string",
              "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
            },
            "until": {
              "type": "string",
              "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
            },
            "certainty": {
              "enum": [
                "exact",
                "approximate",
                "disputed"
              ]
            }
          },
          "required": [
            "kind",
            "from",
            "until",
            "certainty"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "observation"
            },
            "observationDate": {
              "type": "string",
              "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
            },
            "certainty": {
              "enum": [
                "exact",
                "approximate",
                "disputed"
              ]
            }
          },
          "required": [
            "kind",
            "observationDate",
            "certainty"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event"
            },
            "date": {
              "type": "string",
              "pattern": "^(?:\\d{4}|-\\d{6}|\\+\\d{6})(?:-\\d{2}(?:-\\d{2})?)?$"
            },
            "certainty": {
              "enum": [
                "exact",
                "approximate",
                "disputed"
              ]
            }
          },
          "required": [
            "kind",
            "date",
            "certainty"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "same",
            "different",
            "uncertain"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "relationship"
      ],
      "additionalProperties": false
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "sourceIdentifier",
    "entityId",
    "category",
    "value",
    "temporal",
    "scope",
    "sourceIds",
    "qualifications"
  ],
  "additionalProperties": false
}
