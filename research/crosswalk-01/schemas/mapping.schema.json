{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Time-bounded field-specific historical compatibility",
  "type": "object",
  "required": [
    "id",
    "atlasEntityId",
    "external",
    "class",
    "period",
    "fields",
    "territorial",
    "rationale",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "atlasEntityId": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "external": {
      "type": "object"
    },
    "period": {
      "type": "object"
    },
    "territorial": {
      "type": "object"
    },
    "rationale": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "worker": {
      "type": "string"
    },
    "review": {
      "type": "object"
    },
    "continuityEstablished": {
      "type": "boolean"
    },
    "competingEntity": {
      "type": "boolean"
    },
    "mutualScopeEvidence": {
      "type": "string"
    },
    "directAssociationEvidence": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
