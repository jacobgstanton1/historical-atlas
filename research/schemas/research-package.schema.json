{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-atlas.local/schemas/research-package.schema.json",
  "title": "Isolated research handoff; independent review mandatory",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "worker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "specialism": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "specialism"
      ],
      "additionalProperties": false
    },
    "productionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mapIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
        }
      },
      "required": [
        "from",
        "until"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "absenceOfEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "jobId",
    "worker",
    "productionFingerprint",
    "entityId",
    "mapIds",
    "period",
    "category",
    "claims",
    "sources",
    "absenceOfEvidence",
    "reviewNotes"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "temporal": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "interval"
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                }
              },
              "required": [
                "kind",
                "from",
                "until"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "observation"
                },
                "observationDate": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                }
              },
              "required": [
                "kind",
                "observationDate"
              ],
              "additionalProperties": false
            }
          ]
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "geographicScope": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "relationship": {
              "enum": [
                "same",
                "different",
                "uncertain"
              ]
            }
          },
          "required": [
            "description",
            "relationship"
          ],
          "additionalProperties": false
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "supportedPrecision": {
                "enum": [
                  "year",
                  "month",
                  "day"
                ]
              },
              "supportsClaim": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "sourceId",
              "note",
              "supportedPrecision",
              "supportsClaim"
            ],
            "additionalProperties": false
          }
        },
        "reviewStatus": {
          "enum": [
            "clear",
            "required",
            "unresolved"
          ]
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "object",
          "properties": {
            "personId": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "lifespan": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "interval"
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                }
              },
              "required": [
                "from",
                "until"
              ],
              "additionalProperties": false
            },
            "relevance": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "interval"
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                },
                "until": {
                  "type": "string",
                  "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
                }
              },
              "required": [
                "from",
                "until"
              ],
              "additionalProperties": false
            },
            "relationship": {
              "type": "string",
              "minLength": 1
            },
            "activity": {
              "type": "string",
              "minLength": 1
            },
            "contribution": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "personId",
            "name",
            "categories",
            "lifespan",
            "relevance",
            "relationship",
            "activity",
            "contribution"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "category",
        "value",
        "temporal",
        "entityId",
        "geographicScope",
        "sourceIds",
        "evidence",
        "reviewStatus",
        "cautions"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "institution",
        "url",
        "accessed",
        "usage",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
